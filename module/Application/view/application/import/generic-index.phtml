<script type="text/javascript">
var count = 1;
var total = <?=$total?>;
var host = window.location.host;
var url = new URL(window.location.href);

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

async function api(endpoint, progressElementId, options = {}) {
    const {
        baseDelay = 150,
        maxDelay = 2000,
        maxRetries = 5,
        timeoutMs = 10000
    } = options;

    let count = 1;
    let retries = 0;
    let currentDelay = baseDelay;

    const progressEl = document.getElementById(progressElementId);
    if (!progressEl) {
        console.error('Progress element not found:', progressElementId);
        return;
    }

    while (count > 0) {
        try {
            await delay(currentDelay);

            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), timeoutMs);

            let response;
            try {
                response = await fetch(window.location.href + '/' + endpoint, {
                    signal: controller.signal,
                    cache: 'no-store'
                });
            } finally {
                clearTimeout(timeout);
            }

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const text = await response.text();

            if (!text || !text.trim()) {
                throw new Error('Empty response');
            }

            let data;
            try {
                data = JSON.parse(text);
            } catch (err) {
                console.error('Bad JSON response:', text);
                throw new Error('Invalid JSON');
            }

            if (typeof data.count !== 'number') {
                throw new Error('Missing or invalid "count" in response');
            }

            // Reset retry state on success
            retries = 0;
            currentDelay = baseDelay;

            count = data.count;

            const percentage = ((total - count) / total) * 100;
            progressEl.style.width = percentage + '%';

        } catch (err) {
            console.warn('API loop issue:', err.message);

            retries++;

            if (retries > maxRetries) {
                console.error('Max retries exceeded. Stopping process.');
                break;
            }

            // exponential backoff (capped)
            currentDelay = Math.min(currentDelay * 2, maxDelay);

            // continue loop instead of crashing
            continue;
        }
    }

    console.log('Process finished or stopped.');
}

jQuery(function($) {
    $('#BEGIN-PROCESS').on('click', function(event) {
    	event.preventDefault();
    	api('process', 'PROCESS-PROGRESS');
    });
    
    $('#BEGIN-IMPORT').on('click', function(event) {
    	event.preventDefault();
    	api('import', 'IMPORT-PROGRESS');
    });
});
</script>

